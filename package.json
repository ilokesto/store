{
  "name": "@ilokesto/store",
  "version": "2.1.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilokesto/store.git"
  },
  "homepage": "https://github.com/ilokesto/store",
  "author": "Jeong Jinho <wpfekdml@me.com>",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && pnpm test:unit && pnpm test:types && pnpm test:tooling",
    "test:watch": "vitest",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "test:unit": "vitest run tests/unit",
    "test:types": "tsc --noEmit -p tests/tsconfig.json"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/node": "26.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "yaml": "2.8.2"
  },
  "packageManager": "pnpm@10.17.1"
}
