{
  "name": "@ilokesto/store",
  "version": "1.1.2",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilokesto/store"
  },
  "homepage": "https://ilokesto.ayden94.com/ko/store",
  "packageManager": "pnpm@10.17.1",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "publishConfig": {
    "access": "public"
  },
  "author": "Jeong Jinho <wpfekdml@me.com>",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.28.0",
    "@types/node": "^26.1.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}
